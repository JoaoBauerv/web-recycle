.env
/vendor
.claude
/balanca-agent
# A pasta de imagens mistura asset da interface com arquivo enviado por usuário.
# Os assets (logo, avatar padrão, prints do README) são versionados; as fotos de
# perfil que os usuários sobem, não.
/images/*
!/images/logo.png
!/images/readme/
!/images/user/
/images/user/*
!/images/user/padrao.png
/docs

# O schema é versionado: a baseline, as migrations datadas e o seed de
# instalação são o que permite recriar o banco em outra máquina. Ficam de fora
# os dumps e as massas de demonstração, que são volumosas e descartáveis.
/sql/backup/
/sql/seed_dados_demo.php
/sql/seed_operacao.php
/sql/seed_operacao.json
/sql/seed_teste.php
/sql/seed_teste.json

# Comprovantes enviados pelos parceiros são documentos de terceiros: o .htaccess
# que bloqueia a pasta é versionado, os arquivos nunca.
/uploads/comprovantes_venda/*
!/uploads/comprovantes_venda/.htaccess

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*/)?\\..*", "status": 404 },
    { "src": "/(sql|vendor|docs|design-system|node_modules|api|uploads)(/.*)?", "status": 404 },
    { "src": "/(composer\\.(json|lock)|package(-lock)?\\.json|neon\\.ts|vercel\\.json)", "status": 404 },
    { "src": "/.*\\.md", "status": 404 },
    { "src": "/.*\\.php", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index.php" }
  ]
}

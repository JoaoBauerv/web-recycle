# Configurações de APP
# APP_NAME identifica a empresa no sistema: aparece no menu, no comprovante de
# compra e na planilha de exportação — esta última falha se o campo estiver vazio.
APP_NAME=EcoRecicla
APP_ENV=local

# Endereço em que o sistema responde, SEM a barra no fim. No XAMPP, com o projeto
# em C:\xampp\htdocs\web-recycle, é o valor abaixo. Se mudar o nome da pasta ou
# usar um VirtualHost próprio, ajuste aqui — todo redirecionamento e todo link de
# imagem do sistema é montado a partir desta variável.
URL_BASE=http://localhost/web-recycle

# Integração com balança. Deixe VAZIO: o peso é digitado manualmente.
# O agente que conversa com a balança é um projeto separado, fora deste repositório.
BALANCA_API_URL=

# Configurações de DB — PostgreSQL
# O banco é criado como 'reciclagem' e as tabelas vivem no schema 'reciclagem'
# (banco.php aplica SET search_path TO reciclagem a cada conexão).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=reciclagem
DB_USER=postgres
DB_PASS=sua_senha

# Configurações de Email — usado para enviar o comprovante de compra ao cliente.
# Sem preencher, o sistema funciona; apenas o envio de comprovante falha.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=seu_usuario
MAIL_PASSWORD=sua_senha
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contato@ecorecicla.com
MAIL_FROM_NAME="EcoRecicla - Sistema de Reciclagem"

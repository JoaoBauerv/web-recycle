RewriteEngine On

# Arquivos que existem no disco mas nunca podem sair pela web. Precisa vir ANTES
# da regra que serve arquivo real, senão ela os entrega direto.
#   .env, .git/, .gitignore  credenciais do banco e do SMTP, histórico do código
#   sql/                     schema e seeds
#   backups/                 dumps do banco: dado pessoal real
#   vendor/, composer.*      bibliotecas e versões instaladas
#   docs/, design-system/    material de projeto, não da aplicação
#   *.md                     READMEs
RewriteRule (^|/)\. - [F]
RewriteRule ^(sql|backups|vendor|docs|design-system)(/|$) - [F]
RewriteRule ^composer\.(json|lock)$ - [F]
RewriteRule \.md$ - [F]

# Se o pedido corresponder a um arquivo ou pasta real (css, js, images, views/user/login.php,
# functions/*, etc.), serve normalmente — nada é reescrito.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fotos de perfil enviadas moram no banco (tabela arquivo): o que não existe em
# images/user/ é entregue por functions/user/foto.php.
RewriteRule ^images/user/([^/]+)$ functions/user/foto.php?nome=$1 [L]

# /pagina  ou  /pagina/acao   =>  index2.php?pagina=pagina/acao
# (preserva querystring existente, ex: /clientes/editar?id=5)
RewriteRule ^([a-zA-Z0-9_\-]+(/[a-zA-Z0-9_\-]+)?)/?$ index2.php?pagina=$1 [QSA,L]

# Segunda camada para os mais sensíveis, caso o mod_rewrite esteja desligado.
<FilesMatch "^(\.env|\.gitignore|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
